{
  "mcpServers": {
    "browser": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/src/index.js"
      ],
      "env": {
        "SUPER_TESTER_EXTENSION_PATH": "${CLAUDE_PLUGIN_ROOT}/extension"
      }
    },
    "continuum": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/plugins/continuum/mcp/server.js"
      ]
    }
  }
}
